# Supabase жобасының параметрлері (Project Settings → API).
# Бұл файлды .env деп көшіріп, мәндерді толтырыңыз.
# Тек "anon public" кілтін қолданыңыз! "service_role" кілтін ЕШҚАШАН бұл жерге жазбаңыз.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Видео файлының ең үлкен көлемі (МБ). supabase/schema.sql ішіндегі шекпен бірдей болуы керек.
VITE_MAX_VIDEO_MB=50
